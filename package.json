{
  "name": "@typespecs/blocknote",
  "version": "0.1.0",
  "description": "TypeSpec definitions for BlockNote document schema",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "typespec": "./lib/main.tsp"
    }
  },
  "scripts": {
    "build": "tsp compile lib/.",
    "watch": "tsp compile lib/. --watch",
    "format": "tsp format lib/**/*.tsp"
  },
  "peerDependencies": {
    "@typespec/compiler": "~1.9.0"
  },
  "dependencies": {
    "@typespec/json-schema": "~1.9.0"
  }
}
